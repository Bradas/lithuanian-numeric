        <action id="spaceAccents">
            <when state="none" output=" "/>
            <when state="1" output="´"/>
            <when state="2" output="`"/>
            <when state="3" output="ˆ"/>
            <when state="4" output="¨"/>
            <when state="5" output="˜"/>
            <when state="7" output="/"/>
        </action>
        <action id="w">
            <when state="none" output="w"/>
            <when state="7" output="↑"/>
        </action>
        <action id="x">
            <when state="none" output="x"/>
            <when state="7" output="↔"/>
        </action>
        <action id="z">
            <when state="none" output="z"/>
            <when state="7" output="↙"/>
        </action>
        <action id="Č">
            <when state="none" output="Č"/>
            <when state="7" output="₂"/>
        </action>
        <action id="Š">
            <when state="none" output="Š"/>
            <when state="7" output="₆"/>
        </action>
        <action id="š">
            <when state="none" output="š"/>
            <when state="7" output="⁶"/>
        </action>
        <action id="ž">
            <when state="none" output="ž"/>
        </action>
        <action id="“">
            <when state="none" output="“"/>
            <when state="7" output="⁰"/>
        </action>
        <action id="„">
            <when state="none" output="„"/>
            <when state="7" output="⁹"/>
        </action>
    </actions>
    <terminators>
        <when state="1" output="´"/>
        <when state="2" output="`"/>
        <when state="3" output="ˆ"/>
        <when state="4" output="¨"/>
        <when state="5" output="˜"/>
        <when state="7" output="/"/>
    </terminators>
</keyboard>
